# We Park Application Environment Configuration
# Copy this file to .env.local and update the values

# ===============================================
# DATABASE CONFIGURATION
# ===============================================

# Choose ONE of the following DATABASE_URL options:

# Option 1: Docker MySQL (Recommended for development)
DATABASE_URL="mysql://root:password@localhost:3306/wepark_db"

# Option 2: Local MySQL with custom password
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/wepark_db"

# Option 3: XAMPP/WAMP (usually no password)
# DATABASE_URL="mysql://root:@localhost:3306/wepark_db"

# Option 4: Custom MySQL user
# DATABASE_URL="mysql://wepark_user:wepark_pass@localhost:3306/wepark_db"

# Option 5: Remote MySQL
# DATABASE_URL="mysql://username:password@your-host:3306/wepark_db"

# ===============================================
# AUTHENTICATION CONFIGURATION
# ===============================================

# NextAuth Secret (Generate a secure random string)
NEXTAUTH_SECRET="your-super-secret-jwt-key-here-change-this-in-production"

# NextAuth URL (Your application URL)
NEXTAUTH_URL="http://localhost:3000"

# ===============================================
# GOOGLE OAUTH (Optional)
# ===============================================

# Get these from Google Cloud Console
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===============================================
# PAYMENT GATEWAY CONFIGURATION (Optional)
# ===============================================

# TeleBirr API Configuration
# TELEBIRR_API_KEY="your-telebirr-api-key"
# TELEBIRR_API_SECRET="your-telebirr-secret"

# Chapa Payment Gateway
# CHAPA_SECRET_KEY="your-chapa-secret-key"

# CBE Birr Configuration
# CBE_BIRR_API_KEY="your-cbe-api-key"

# ===============================================
# EMAIL CONFIGURATION (Optional)
# ===============================================

# SMTP Configuration for notifications
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# ===============================================
# APPLICATION SETTINGS
# ===============================================

# Environment (development, staging, production)
NODE_ENV="development"

# Application Name
APP_NAME="We Park"

# Support Email
SUPPORT_EMAIL="support@wepark.com"

# ===============================================
# DEVELOPMENT TOOLS
# ===============================================

# Enable Prisma Studio logs
# PRISMA_LOGS="true"

# Enable NextAuth debug logs
# NEXTAUTH_DEBUG="true"

# ===============================================
# INSTRUCTIONS
# ===============================================

# 1. Copy this file: cp .env.local.template .env.local
# 2. Update DATABASE_URL with your MySQL credentials
# 3. Generate a secure NEXTAUTH_SECRET
# 4. Save and restart your development server
# 5. Run: npx prisma db push
# 6. Seed data: curl -X POST http://localhost:3000/api/setup-admin

# ===============================================
# SAMPLE COMMANDS
# ===============================================

# Start MySQL with Docker:
# docker run --name wepark-mysql -e MYSQL_ROOT_PASSWORD=password -e MYSQL_DATABASE=wepark_db -p 3306:3306 -d mysql:8.0

# Test database connection:
# npx prisma studio

# Generate secure secret:
# openssl rand -base64 32
